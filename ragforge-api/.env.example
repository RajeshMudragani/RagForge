# Server
NODE_ENV=development
PORT=7892
LOG_LEVEL=info
API_PREFIX=/api/v1
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=50mb
UPLOAD_MAX_FILE_SIZE_MB=100

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Ollama and embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-a-local-minio-secret
MINIO_BUCKET=documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# JWT token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# General and per-route rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
EVALUATION_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=600000
CHAT_RATE_LIMIT_WINDOW_MS=600000
EVALUATION_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_WINDOW_MS=600000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTLs
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_AUTH_KEY_TTL_SECONDS=3600
CACHE_COLLECTION_TTL_SECONDS=900
CACHE_RETRIEVAL_TTL_SECONDS=300

# Background jobs and contextual enrichment
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=5000
CONTEXTUAL_ENRICHMENT_ENABLED=false
CONTEXTUAL_ENRICHMENT_CONCURRENCY=3

# LLM providers. The schema requires Gemini values even when Ollama is selected.
LLM_PROVIDER=ollama
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=replace-with-your-gemini-api-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free